# Shoreline environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# Leave BOTH Supabase values empty to run in MOCK MODE (single device, no networking).

# Supabase project URL — Supabase Dashboard → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public client key — the "anon" key or the newer "publishable" key (sb_publishable_...).
# This key is designed to be public; Shoreline uses Realtime Broadcast + Presence only (no tables).
# NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force a transport. "mock" | "supabase". Default: supabase if both values above are set, else mock.
NEXT_PUBLIC_SHORELINE_TRANSPORT=
